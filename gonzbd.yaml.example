# =============================================================================
# GoNZBD Configuration — Example
# =============================================================================
# Copy this file to gonzbd.yaml and customize for your setup.
# gonzbd will auto-generate API keys on first run if they are empty.
#
# Values that accept sizes use K/M/G/T suffixes (base-1024).
# Path fields support $ENV_VAR expansion.
# =============================================================================

general:
  # Bind address for the HTTP listener. Use 0.0.0.0 to listen on all
  # interfaces, or 127.0.0.1 to restrict to localhost only.
  host: 0.0.0.0

  # HTTP port. Must be 1-65535. Default: 4289.
  port: 4289

  # HTTPS port. Set to 0 to disable HTTPS entirely.
  # When enabled, both https_cert and https_key must be set.
  https_port: 0
  https_cert: ""
  https_key: ""

  # API key for authenticating API requests. 16-character lowercase hex.
  # Auto-generated on first run. Required for external tools like
  # Sonarr, Radarr, and NZB360 to communicate with gonzbd.
  api_key: ""

  # Separate API key for NZB-upload endpoints only. Allows giving
  # upload-only access to indexers without exposing the full API key.
  nzb_key: ""

  # Client IP ranges trusted to receive and use the web UI's ephemeral
  # session cookie, IN ADDITION to loopback (127.0.0.1/::1), which is always
  # trusted. Each entry is a CIDR ("10.0.0.0/8", "fd00::/8") or a bare IP
  # ("192.168.1.5"). Empty (the default) means loopback-only: a non-loopback
  # client — LAN, Docker bridge, or a reverse proxy — is NOT handed an admin
  # session cookie, so the web UI will appear logged out for it. Set this to
  # your reverse-proxy / Docker network / LAN CIDR to let the UI work for
  # those clients without entering a key. This does NOT affect API-key or
  # NZB-key authentication, which work from any address.
  #
  # IMPORTANT if you run gonzbd behind ANY reverse proxy (nginx, Caddy,
  # Traefik, etc.), even one on the same host: the proxy makes every request
  # arrive with a loopback/local remote address regardless of who the real
  # client is. Set local_ranges to the proxy's own address AND set
  # verify_xff_header: true below — otherwise cookie-based web UI login is
  # refused for every client once a forwarding header is present (see
  # verify_xff_header). API-key/NZB-key auth is unaffected either way.
  local_ranges: []

  # When true, the forwarding header selected by trusted_forward_header
  # below is also validated: once the direct peer is trusted (loopback or
  # local_ranges), every forwarded hop in that header must also be trusted
  # or the request is treated as untrusted. When false (the default) and
  # NO forwarding header is present,
  # trust is based on the peer address alone, same as before. But if ANY of
  # those headers IS present while this is false, the request now fails
  # closed (rejected) rather than trusting the peer address blindly — a
  # header's mere presence means a proxy may be interposed, and an unverified
  # peer address (which the proxy controls) proves nothing about the real
  # client. This is a deliberate fail-closed default: do not set this to
  # false as a way to "make cookie auth work" behind a proxy — set it to
  # true and configure local_ranges to the proxy's address instead. The
  # header is never consulted when the direct peer is untrusted, so it
  # cannot be spoofed by a public client.
  verify_xff_header: false

  # Which single forwarding header your reverse proxy actually manages
  # (sets/overwrites reliably): "x-forwarded-for" (the default when empty),
  # "forwarded" (RFC 7239), or "x-real-ip". Only used when verify_xff_header
  # is true. Only this header is ever checked for hop-trust purposes — the
  # other two are ignored even if present. Setting this correctly matters:
  # a proxy that reliably overwrites one header may pass another through
  # from the client completely untouched, and without an explicit choice
  # here a client could inject a forged value in the header you're NOT
  # relying on and have it silently win. This mirrors nginx's
  # real_ip_header directive, which requires the same explicit choice.
  trusted_forward_header: ""

  # Working directory for in-progress downloads. Files here are
  # incomplete and should not be accessed by media scanners.
  # Created automatically on startup if it does not exist.
  download_dir: Downloads/incomplete

  # Destination for completed and post-processed jobs. Media scanners
  # (Plex, Jellyfin, etc.) should point at this directory.
  complete_dir: Downloads/complete

  # Watched folder for drop-in NZB files. Any .nzb file placed here
  # is automatically queued for download. Empty disables the scanner.
  dirscan_dir: ""

  # How often (in seconds) to scan dirscan_dir for new NZB files.
  # Lower values mean faster pickup but more I/O. Default: 5.
  dirscan_speed: 5

  # Directory containing user post-processing scripts. Scripts here
  # are available for selection in category settings. See
  # docs/post-processing-scripts.md for the script contract.
  script_dir: ""

  # Directory for gonzbd's own log files (gonzbd.log). Empty means
  # stderr-only (no file logging). Only used in serve mode.
  log_dir: ""

  # Directory for queue state and admin data. Stores the persistent
  # job queue in SQLite (queue.db) and immutable manifests in
  # manifests/<id>.json.gz between restarts. Defaults to
  # <download_dir>/admin if empty.
  admin_dir: admin

  # How long a finished job stays in history, in days. 0 keeps it
  # forever (the default).
  #
  # Deleting a history entry also releases what it owns: the per-file
  # download progress retained for failed jobs, and the gzipped NZB
  # under admin/nzb/. A pruned job can therefore no longer be retried.
  #
  # The sweep runs at startup and after each job finishes.
  history_retention_days: 0

  # The same threshold for jobs that failed, kept separate so a failure
  # can outlive a success — it is the outcome you are most likely to
  # want to inspect or retry later. 0 keeps failed jobs forever.
  history_failed_retention_days: 0

  # Global minimum log level: debug, info, warn, error. Default: info.
  log_level: info

  # Per-component log level overrides. Components not listed here
  # inherit the global log_level. Valid levels: debug, info, warn,
  # error, off. Use this to suppress noisy subsystems while keeping
  # errors visible.
  #
  # Common components: api, main, downloader, assembler, nntp, queue,
  #   postproc, decoder, dirscanner, rss, sorting, deobfuscate,
  #   unrar, sevenzip, filejoin
  #
  # Example:
  #   log_levels:
  #     api: warn          # suppress routine API request logging
  #     downloader: debug  # verbose download pipeline output
  #     nntp: error        # only show NNTP errors
  #     rss: off           # completely silence RSS feed checks

  # Reserved for future UI translation support. Currently unused —
  # the UI is English-only. Default: en.
  language: en

downloads:
  # Maximum download bandwidth. Accepts K/M/G suffixes. "0" or empty
  # means unlimited. This is a hard ceiling; actual throughput is
  # further limited by bandwidth_perc.
  bandwidth_max: ""

  # Percentage of bandwidth_max to actually use (0-100). Useful for
  # throttling without changing the max. Default: 100.
  bandwidth_perc: 100

  # Minimum free disk space on the download volume. The downloader
  # pauses when free space drops below this threshold. Accepts K/M/G
  # suffixes. Default: 1G.
  min_free_space: 1G

  # Memory budget for write coalescing in the assembler. Decoded
  # articles are buffered and flushed as larger sequential writes,
  # reducing I/O syscalls. Higher values improve throughput on spinning
  # disks but consume more RAM. "0" disables coalescing. Default: 500M.
  write_cache_size: 500M

  # Maximum retry attempts per article across all servers before
  # marking the article as permanently failed. Must be >= 1.
  max_art_tries: 3

  # Maximum retry attempts per article on optional (backup) servers
  # specifically. Must be >= 0.
  max_art_opt: 1

  # Maximum number of jobs downloading or repairing concurrently.
  # Defaults to 4.
  max_active_jobs: 4

  # When true, only dispatch articles to the highest-priority server.
  # Disables fallback to backup servers entirely.
  top_only: false

  # When true, replace all server penalty durations with a short
  # constant. Useful for testing/debugging only.
  no_penalties: false

  # Issue NNTP STAT before BODY to verify article existence. Trades
  # latency for fewer wasted bytes on missing articles. Useful when
  # using multiple servers with different retention windows.
  pre_check: false

  # Minutes to wait after a job is added before downloading begins.
  # Allows articles to propagate to backup/fill servers. 0 disables.
  propagation_delay: 0

  # Character used to replace illegal filesystem characters
  # (\ / : * ? " < > |) in filenames. Default: "_".
  replace_illegal_with: _

  # Character used to replace spaces in filenames. Empty string means
  # keep spaces as-is.
  replace_spaces_with: ""

  # When true, replace accented/diacritical characters with ASCII
  # equivalents (e.g., é → e, ü → u).
  strip_diacritics: false

  # Regex patterns removed from job folder names. Applied in order.
  # Used to strip indexer tags, site names, and obfuscation markers
  # that indexers prepend/append to NZB names.
  cleanup_list:
    - ^(?i)\[PRiVATE\]-?
    - ^(?i)\[nzbndx\]-?
    - ^(?i)\[DrunkenSlug\]-?
    - ^(?i)\[Geek\]-?
    - ^\[.*\]-?
    - ^(?i)www\..*\.[a-z]{2,3}-?
    - (?i)-? ?\(Scenzbd\)$
    - (?i)-? ?\(Obfuscated\)$
    - (?i)-? ?\(NZBGeek\)$

postproc:
  # Enable RAR archive extraction. Requires unrar or 7z on PATH.
  enable_unrar: true

  # Enable 7z archive extraction. Requires 7z on PATH.
  enable_7zip: true

  # Enable plain .tar archive extraction (not compressed variants like
  # .tar.gz/.tgz). Uses a pure-Go extractor, no external tool required.
  # Matches SABnzbd's cfg.enable_tar(). Default true.
  enable_tar: true

  # Enable split file joining (.001/.002/...). When false, split files
  # are left as-is. Matches SABnzbd's cfg.enable_filejoin(). Default true.
  enable_filejoin: true

  # Enable TS file joining (.ts.001/.ts.002/...). TS splits are handled
  # by the same join logic as numeric splits. Matches SABnzbd's
  # cfg.enable_tsjoin(). Default true.
  enable_tsjoin: true

  # Enable recursive unpacking: after each extraction pass, re-scan for
  # newly extracted archives up to 3 levels deep. Disable to only extract
  # the outermost archives. Matches SABnzbd's cfg.enable_recursive().
  enable_recursive: true

  # Delete par2 parity files after a successful repair.
  enable_par_cleanup: true

  # Delete source archive files (RAR, 7z, split) after successful
  # extraction. Set to false to keep originals alongside extracted files.
  enable_rar_cleanup: true

  # Scan extracted archives for par2 files and use them for 16K-MD5
  # filename recovery. Helps deobfuscate files from nested archives.
  # Matches SABnzbd's cfg.process_unpacked_par2(). Default true.
  process_unpacked_par2: true

  # Attempt to recover a fully obfuscated RAR5 volume set (no filename
  # numbering clue at all, and no PAR2 protection covering the volumes)
  # by reading volume sequencing directly from each file's RAR5 header,
  # then renaming to canonical part-numbered names. A no-op whenever
  # normal filename-based RAR detection already finds something, so
  # safe to leave enabled. Default true.
  enable_rar_volume_recovery: true

  # Path to the par2 binary. Can be a bare name (resolved via PATH)
  # or an absolute path. Default: "par2".
  par2_command: par2

  # Path to the unrar binary. Empty triggers auto-detection on PATH.
  unrar_command: ""

  # Path to the 7z binary. Empty triggers auto-detection on PATH.
  sevenz_command: ""

  # Use par2cmdline-turbo invocation arguments when supported by the
  # par2 binary. Enables multi-threaded repair.
  par2_turbo: false

  # Maximum payload size (in bytes) of a single PAR2 packet body. A safety
  # limit that prevents memory exhaustion from malformed or malicious PAR2
  # files. Default 67108864 (64 MiB); minimum floor 65536 (64 KiB). A value
  # of 0 (or below the floor) falls back to the default — there is no
  # "unlimited" setting; raise this explicitly for genuinely large recovery
  # packets.
  par2_max_packet_body_size: 67108864

  # Maximum forward search distance (in bytes) when scanning a file for the
  # next PAR2 magic header. Bounds CPU/IO spent on corrupt files. Default
  # 65536 (64 KiB); minimum floor 1024 (1 KiB). 0 or below-floor uses the
  # default.
  par2_max_junk_scan_bytes: 65536

  # Discard in-archive modification timestamps during extraction (passes
  # -tsm- to unrar). Files will use the extraction time instead of the
  # original modification date.
  ignore_unrar_dates: false

  # Allow extraction to overwrite existing files in the destination.
  # When false, existing files are preserved and extraction may fail
  # if a name collision occurs.
  overwrite_files: false

  # Write all extracted files flat into the job directory, ignoring
  # any subdirectory structure inside the archive.
  flat_unpack: false

  # Use the pure-Go rarengine library for RAR5 extraction instead of
  # shelling out to the unrar binary. No external binary required.
  # Falls back to subprocess unrar on extraction error or for RAR3/4.
  # Default true.
  prefer_go_rar: true

  # Begin extracting files while the download is still in progress.
  # Completed RAR volumes are fed to an interactive unrar subprocess as
  # they arrive, overlapping download and extraction I/O. Falls back to
  # standard unpack on failure. Requires enable_unrar=true and is
  # incompatible with prefer_7zip (7z does not support unrar's -vp
  # interactive protocol). When both are enabled, a startup warning is
  # logged and DirectUnpack is effectively disabled.
  direct_unpack: false

  # Limit the number of concurrent DirectUnpack workers across all jobs.
  # 0 means no limit (one per active job). Default 3 (matching SABnzbd).
  direct_unpack_threads: 3

  # Rename obfuscated files (random hex strings, UUIDs) to use the
  # job name as a base. Helps media scanners identify content.
  deobfuscate_filenames: true

  # Arguments for nice(1), prepended to all external tool commands
  # (unrar, 7z, par2). Reduces CPU scheduling priority to keep the
  # system responsive during post-processing. Recommended: "-n 15".
  # Matches SABnzbd's cfg.nice(). Empty disables nice wrapping.
  nice: ""

  # Arguments for ionice(1), prepended to all external tool commands.
  # Reduces I/O scheduling priority. Recommended: "-c2 -n4"
  # (best-effort class, priority 4). Only effective on Linux with
  # CFQ or BFQ I/O schedulers.
  # Matches SABnzbd's cfg.ionice(). Empty disables ionice wrapping.
  ionice: ""

  # Octal permission string applied recursively to extracted files
  # after successful unpacking. Directories receive the full mode;
  # regular files have execute bits stripped (e.g. "755" gives
  # dirs 0755, files 0644). Matches SABnzbd's cfg.permissions().
  # Empty disables permission setting.
  permissions: ""

  # Path to a text file containing one password per line. Blank lines
  # and lines starting with # are skipped. These passwords are tried
  # after any per-job password during archive extraction.
  # Matches SABnzbd's cfg.password_file(). Empty disables.
  password_file: ""

  # Extra command-line arguments appended to every unrar invocation.
  # Each argument must start with '-'. Example: "-sl100000".
  extra_unrar_params: ""

  # Extra command-line arguments appended to every par2 invocation.
  # Each argument must start with '-'. Example: "-m512".
  # Matches SABnzbd's cfg.extra_par2_parameters().
  extra_par2_params: ""

  # When true, non-zero script exit codes are logged but do NOT mark the
  # job as failed. This matches SABnzbd's cfg.script_can_fail(). Useful
  # when scripts return non-zero for informational/partial-failure reasons
  # that shouldn't prevent the job from being marked as completed.
  # Default: false
  script_can_fail: false

  # When true, replaces SAB_API_KEY and SAB_PASSWORD with "**REDACTED**"
  # in the post-processing script environment. This is a log-hygiene
  # measure — it reduces accidental secret leakage from scripts that
  # log or transmit their full environment, but does NOT provide a
  # security boundary (scripts run as the daemon user and can read
  # gonzbd.yaml from disk). Scripts that use SAB_API_KEY for API
  # callbacks (e.g. Sonarr/Radarr import hooks) will break if this
  # is enabled.
  # Default: false
  redact_script_secrets: false

servers:
  # Each server entry defines an NNTP news server connection.
  # Multiple servers can be configured for redundancy and fill.
  # Articles are dispatched to servers in priority order (lower = higher
  # priority). If a server fails, the next one is tried automatically.

  - # Unique name for this server. Used in logs and penalty tracking.
    name: my-primary-server
    # Hostname or IP address of the NNTP server.
    host: news.example.com
    # TCP port. Common values: 119 (plain), 443/563 (SSL).
    port: 563
    # NNTP authentication credentials.
    username: your_username
    password: your_password
    # Number of simultaneous connections. More connections = faster
    # downloads, but most providers cap this (check your plan).
    connections: 30
    # Enable TLS encryption. Strongly recommended.
    ssl: true
    # Certificate verification level:
    #   0 = none (insecure), 1 = chain only (no hostname check),
    #   2 = hostname match (recommended), 3 = strict (extra checks).
    ssl_verify: 2
    # OpenSSL cipher string. Empty uses system defaults.
    ssl_ciphers: ""
    # Dispatch priority. Lower numbers are tried first. Servers with
    # the same priority are tried in parallel.
    priority: 0
    # Required servers are never auto-deactivated under penalty.
    required: true
    # Optional (backup) servers can be temporarily deactivated when
    # their bad-connection ratio exceeds the threshold.
    optional: false
    # Article retention in days. Articles older than this are not
    # requested from this server. 0 = unlimited.
    retention: 0
    # Per-request socket timeout in seconds.
    timeout: 60
    # Max NNTP commands in-flight per connection. Increase for high-
    # latency servers. Set to 1 if the server misbehaves.
    pipelining_requests: 2
    # Set to false to keep the server configured but skip it entirely.
    enable: true

categories:
  # Categories control per-job post-processing and output routing.
  # Jobs are assigned a category by the API client (Sonarr, Radarr, etc.)
  # or by the user. The category determines which post-processing stages
  # run and where completed files land.
  #
  # "Default" and "*" are required fallback categories and must always exist.

  - name: Default
    # Post-processing flags (bitmask):
    #   0 = nothing, 1 = repair only, 2 = repair + unpack,
    #   3 = repair + unpack + delete archives,
    #   7 = all of the above (repair + unpack + delete + deobfuscate)
    pp: 3
    # Post-processing script name from script_dir. "None" = no script.
    script: None
    # Default job priority. 0 = normal.
    priority: 0
    # Subdirectory within complete_dir. Empty = write to complete_dir root.
    dir: ""

  - name: '*'
    pp: 3
    script: None
    priority: 0
    dir: ""

  - name: tv
    pp: 7
    script: None
    priority: 0
    # TV shows land in complete_dir/tv/.
    dir: tv

  - name: movies
    pp: 7
    script: None
    priority: 0
    dir: movies

# Notifications configuration (optional).
# Controls notification sinks for system events.
notifications:
  # Email notification settings (SMTP).
  email:
    enable: false
    host: "smtp.example.com"
    port: 587
    username: ""
    password: ""
    from: "gonzbd@example.com"
    to:
      - "admin@example.com"
    use_tls: true
    use_ssl: false
    # List of events to notify on. Empty or omitted means all events.
    # Valid events: DownloadStarted, DownloadComplete, DownloadFailed,
    # PostProcessingComplete, PostProcessingFailed, DiskFull, QueueDone, Warning, Error.
    events: []

  # Apprise notifications.
  apprise:
    enable: false
    # URL of a local Apprise API instance or similar service endpoint.
    url: ""
    service_url: ""
    events: []

  # Custom script notification.
  script:
    enable: false
    # Path to the script. Can be relative to configuration dir or absolute.
    # Environment variables and leading ~ are expanded.
    path: ""
    timeout: 30
    events: []
