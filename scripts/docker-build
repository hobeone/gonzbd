#!/bin/sh
# docker-build — stamps version info into a local Docker build.
# Usage: ./scripts/docker-build [extra docker build args...]
#
# Examples:
#   ./scripts/docker-build
#   ./scripts/docker-build --no-cache
#   ./scripts/docker-build --platform linux/arm64

set -e

. "$(dirname "$0")/lib/buildmeta.sh"

echo "Building gonzbd Docker image"
echo "  VERSION:     ${VERSION}"
echo "  COMMIT:      ${COMMIT}"
echo "  COMMIT_TIME: ${COMMIT_TIME}"
echo "  DIRTY:       ${DIRTY}"
echo "  BUILD_DATE:  ${BUILD_DATE}"

exec docker build \
  --build-arg VERSION="${VERSION}" \
  --build-arg COMMIT="${COMMIT}" \
  --build-arg COMMIT_TIME="${COMMIT_TIME}" \
  --build-arg DIRTY="${DIRTY}" \
  --build-arg BUILD_DATE="${BUILD_DATE}" \
  -t gonzbd:latest \
  -t "gonzbd:${VERSION}" \
  "$@" .
